+import { shadow } from "pdfjs-lib";
+
+let activeService = null;
+
+class ChromePrintService {
+  get active() {
+    return this === activeService;
+  }
+
+  layout() {}
+
+  destroy() {
+    if (!this.active) {
+      return;
+    }
+    activeService = null;
+  }
+}
+
+class PDFPrintServiceFactory {
+  static initGlobals() {}
+
+  static get supportsPrinting() {
+    return shadow(this, "supportsPrinting", true);
+  }
+
+  static createPrintService() {
+    if (activeService) {
+      throw new Error("The print service is already created and active.");
+    }
+    return (activeService = new ChromePrintService());
+  }
+}
+
+export { PDFPrintServiceFactory };
